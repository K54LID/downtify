# Telegram - get your bot token from @BotFather
BOT_TOKEN=
# Comma-separated Telegram user IDs who get admin access
ADMIN_IDS=123456789,987654321
BOT_USERNAME=Downtify_Bot

# Subscription
SUBSCRIPTION_STARS=100
SUBSCRIPTION_DAYS=30

# Database (leave host/port as-is for Docker Compose; they match the
# postgres/redis service names Coolify will run alongside the bot)
POSTGRES_USER=Downtify
POSTGRES_PASSWORD=changeme
POSTGRES_DB=Downtify
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Limits
RATE_LIMIT_PER_MINUTE=30
DOWNLOAD_MAX_FILESIZE_MB=1024

# Logging
LOG_LEVEL=INFO

# Webhook (optional). Leave all blank to run in long-polling mode (default,
# recommended - no domain or public port needed).
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
WEBHOOK_SECRET=

# Local Telegram Bot API server (used to lift the normal 20/50MB upload
# limit). Get these from https://my.telegram.org -> "API development tools".
# Required by the telegram-bot-api service in docker-compose.yml.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
