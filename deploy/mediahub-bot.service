[Unit]
Description=Downtify Telegram Bot
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=Downtify
WorkingDirectory=/opt/Downtify-bot
EnvironmentFile=/opt/Downtify-bot/.env
ExecStart=/opt/Downtify-bot/.venv/bin/python -m app.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
